
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ИмяПользователя = ПользователиИнформационнойБазы.ТекущийПользователь().Имя;
	КлючНастроек = "Session_" + ИмяПользователя;	
	
	ДанныеСессии = ХранилищеОбщихНастроек.Загрузить("SaaSAuth", КлючНастроек);
	Если ДанныеСессии <> Неопределено Тогда
		мТокен = ?(ДанныеСессии.Свойство("Токен"), ДанныеСессии.Токен, "");
		мEmail = ?(ДанныеСессии.Свойство("Email"), ДанныеСессии.Email, "");        
	КонецЕсли;
	
	Идентификатор = ХранилищеОбщихНастроек.Загрузить("BlockSchemesClient", КлючНастроек);
    Если Не ЗначениеЗаполнено(Идентификатор) Тогда
        Идентификатор = Строка(Новый УникальныйИдентификатор());
        ХранилищеОбщихНастроек.Сохранить("BlockSchemesClient", КлючНастроек, Идентификатор);
    КонецЕсли;
    мClientId = Идентификатор;	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)	
	ОбновитьИнтерфейсПоТекущемуСостоянию();
КонецПроцедуры


&НаКлиенте
Процедура Зарегистрироваться(Команда)
    ОписаниеОповещения = Новый ОписаниеОповещения("ОбработатьЗакрытиеФормыРегистрации", ЭтаФорма);
    Попытка
        ОткрытьФорму("Обработка.КонвертерMarkdown.Форма.ФормаРегистрация",,ЭтаФорма,,,,ОписаниеОповещения);
    Исключение
        ОткрытьФорму("ВнешняяОбработка.КонвертерMarkdown.Форма.ФормаРегистрация",,ЭтаФорма,,,,ОписаниеОповещения);
    КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьЗакрытиеФормыРегистрации(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
    ДанныеСессии = ВосстановитьСессиюНаСервере();
    Если ДанныеСессии <> Неопределено Тогда
        мТокен = ?(ДанныеСессии.Свойство("Токен"), ДанныеСессии.Токен, "");
        мEmail = ?(ДанныеСессии.Свойство("Email"), ДанныеСессии.Email, "");        
    КонецЕсли;
    ОбновитьИнтерфейсПоТекущемуСостоянию();    
КонецПроцедуры


&НаКлиенте
Процедура Выйти(Команда)
    ОчиститьСессиюНаСервере();
    мТокен = "";
    мEmail = "";
    ОбновитьИнтерфейсПоТекущемуСостоянию();    
    
    Сообщить("Ваша сессия завершена. Вы можете продолжить работу анонимно или войти снова.");
КонецПроцедуры

&НаСервере
Процедура ОчиститьСессиюНаСервере()
    ИмяПользователя = ПользователиИнформационнойБазы.ТекущийПользователь().Имя;
    КлючНастроек = "Session_" + ИмяПользователя;
    
    ХранилищеОбщихНастроек.Сохранить("SaaSAuth", КлючНастроек, Неопределено);
КонецПроцедуры

&НаСервере
Функция ВосстановитьСессиюНаСервере()
    ИмяПользователя = ПользователиИнформационнойБазы.ТекущийПользователь().Имя;
    КлючНастроек = "Session_" + ИмяПользователя;
    Данные = ХранилищеОбщихНастроек.Загрузить("SaaSAuth", КлючНастроек);
    Возврат Данные;
КонецФункции

&НаКлиенте
Процедура ОбновитьИнтерфейсПоТекущемуСостоянию()	
    Если ПустаяСтрока(мТокен) И ПустаяСтрока(мEmail) Тогда        
        Элементы.Зарегистрироваться.Видимость = Истина;
		 Элементы.Выйти.Заголовок = "Зарегистрироваться | Войти";
        Элементы.Выйти.Видимость = Ложь;
    Иначе        
        Элементы.Зарегистрироваться.Видимость = Ложь;
        Элементы.Выйти.Видимость = Истина;
        Элементы.Выйти.Заголовок = мEmail + " | Выйти";
    КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура ОтправитьОтзыв(Команда)
    
    Если ПустаяСтрока(ТекстОтзыва) Тогда
        Сообщить("Пожалуйста, напишите текст отзыва перед отправкой.");
        Возврат;
    КонецЕсли;
    
    Элементы.ОтправитьОтзыв.Доступность = Ложь;
	
    ДанныеЗапроса = Новый Структура;
    ДанныеЗапроса.Вставить("procedureName", "КонвертерMD");
    ДанныеЗапроса.Вставить("comment", ТекстОтзыва);
    
    ОтветAPI = ОтправитьЗапросНаАПИ("feedback", ДанныеЗапроса, 5);
    
    Если ОтветAPI.Успех Тогда
        ЭтаФорма.Закрыть();
    Иначе
        Элементы.ОтправитьОтзыв.Доступность = Истина;
        Сообщить(ОтветAPI.ОписаниеОшибки);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ОтправитьЗапросНаАПИ(Метод, ДанныеЗапроса, Знач ТаймаутСек = 60)
    
    Результат = Новый Структура("Успех, Данные, ОписаниеОшибки, ТехОписаниеОшибки",
        Ложь, Неопределено, "", "");
    
    ДанныеЗапроса.Вставить("clientId", мClientId);
    Если ЗначениеЗаполнено(мТокен) Тогда
        ДанныеЗапроса.Вставить("token", мТокен);
        ДанныеЗапроса.Вставить("email", мEmail);
    КонецЕсли;
    
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, ДанныеЗапроса);
    ТекстJSON = ЗаписьJSON.Закрыть();    
    
    Попытка
        HTTPЗапрос = Новый HTTPЗапрос("v1/api.php?method=" + Метод);
        HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
        HTTPЗапрос.УстановитьТелоИзСтроки(ТекстJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
        
        HTTPСоединение = Новый HTTPСоединение("srv200.tail6b04b6.ts.net", 443, , , , ТаймаутСек,
            Новый ЗащищенноеСоединениеOpenSSL());
        HTTPОтвет = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
    Исключение        
        Результат.ТехОписаниеОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
        Результат.ОписаниеОшибки = "Сервис временно недоступен. Попробуйте отправить отзыв позже.";
        Возврат Результат;
    КонецПопытки;    
   
    Попытка
        ТекстОтвета = HTTPОтвет.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
    Исключение
        Результат.ТехОписаниеОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
        Результат.ОписаниеОшибки = "Сервис вернул некорректный ответ. Попробуйте позже.";
        Возврат Результат;
    КонецПопытки;
    
    Если ПустаяСтрока(ТекстОтвета) Тогда
        Результат.ТехОписаниеОшибки = "Пустой ответ (HTTP " + HTTPОтвет.КодСостояния + ")";
        Результат.ОписаниеОшибки = "Сервис вернул некорректный ответ. Попробуйте позже.";
        Возврат Результат;
    КонецЕсли;    
    
    ОтветСтруктура = Неопределено;
    Попытка
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(ТекстОтвета);
        ОтветСтруктура = ПрочитатьJSON(ЧтениеJSON);
    Исключение        
        Результат.ТехОписаниеОшибки = "HTTP " + HTTPОтвет.КодСостояния
            + ", тело: " + Лев(ТекстОтвета, 200);
        Результат.ОписаниеОшибки = "Сервис вернул некорректный ответ. Попробуйте позже.";
        Возврат Результат;
    КонецПопытки;
    
    Если ТипЗнч(ОтветСтруктура) <> Тип("Структура") Тогда
        Результат.ТехОписаниеОшибки = "Тип ответа: " + Строка(ТипЗнч(ОтветСтруктура));
        Результат.ОписаниеОшибки = "Сервис вернул некорректный ответ. Попробуйте позже.";
        Возврат Результат;
    КонецЕсли;    
    
    Если ОтветСтруктура.Свойство("success") И ОтветСтруктура.success Тогда
        Результат.Успех = Истина;
        Результат.Данные = ОтветСтруктура;
    Иначе
        Ошибка = "Не удалось отправить отзыв. Попробуйте позже.";
        Если ОтветСтруктура.Свойство("error") И ЗначениеЗаполнено(ОтветСтруктура.error) Тогда
            Ошибка = Строка(ОтветСтруктура.error); // осмысленные тексты от PHP/бэкенда
        КонецЕсли;
        Результат.ОписаниеОшибки = Ошибка;
    КонецЕсли;
    
    Возврат Результат;
КонецФункции

