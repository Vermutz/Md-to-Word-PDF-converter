////////////////////////////////////////////////////////////////////////////////
// Форма обработки "КонвертерMarkdownВWord" (версия 1.0.0, клиентская).
// Конвейер конвертации (COM Word) - в клиентском контексте формы:
// Word открывается на компьютере пользователя, файловые пути - локальные.
// Веб-клиент не поддерживается (COM-объекты недоступны).
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    
    лОбъект = РеквизитФормыВЗначение("Объект");
    ЗаполнитьФормуПоНастройкам(лОбъект.НастройкиПоУмолчанию());
    
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Конвертировать(Команда)
    
    Если ПустаяСтрока(ТекстMarkdown) Тогда
        ПоказатьПредупреждение(, НСтр("ru = 'Не задан исходный текст Markdown.'"));
        Возврат;
    КонецЕсли;
    
    Если НЕ ПоказатьДокумент И ПустаяСтрока(ПутьФайлаРезультата) Тогда
        ПоказатьПредупреждение(, НСтр("ru = 'Укажите файл результата или включите показ документа Word.'"));
        Возврат;
    КонецЕсли;
    
    Настройки = НастройкиИзДанныхФормы();
    
    Попытка
        КонвертироватьВWord(ТекстMarkdown, ПутьФайлаРезультата, Настройки);
    Исключение
        ПоказатьПредупреждение(, НСтр("ru = 'Ошибка конвертации:'") + Символы.ПС
            + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
        Возврат;
    КонецПопытки;
    
    Если НЕ ПустаяСтрока(ПутьФайлаРезультата) Тогда
        ПоказатьПредупреждение(, НСтр("ru = 'Документ сохранен:'") + Символы.ПС + ПутьФайлаРезультата);
    КонецЕсли;
    
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзФайла(Команда)
    
    Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
    Диалог.МножественныйВыбор = Ложь;
    Диалог.Фильтр = НСтр("ru = 'Текст Markdown (*.md;*.markdown;*.txt)|*.md;*.markdown;*.txt|Все файлы (*.*)|*.*'");
    
    Если НЕ Диалог.Выбрать() Тогда
        Возврат;
    КонецЕсли;
    
    ПолноеИмяФайла = Диалог.ПолноеИмяФайла;
    
    ПараметрыПомещения = Новый Структура("ПолноеИмяФайла", ПолноеИмяФайла);
    Оповещение = Новый ОписаниеОповещения("ЗагрузитьИзФайлаЗавершение", ЭтаФорма, ПараметрыПомещения);
    
    НачатьПомещениеФайла(Оповещение, , ПолноеИмяФайла, Ложь, УникальныйИдентификатор);
    
КонецПроцедуры

&НаКлиенте
Процедура ВставитьТестовыйТекст(Команда)
    ТекстMarkdown = ТестовыйТекст();
КонецПроцедуры

&НаКлиенте
Процедура СброситьНастройки(Команда)
    
    Если Вопрос(НСтр("ru = 'Вернуть все настройки значениям по умолчанию?'"),
        РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
        Возврат;
    КонецЕсли;
    
    ЗаполнитьФормуНаСервере();
    
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ПутьФайлаРезультатаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
    
    СтандартнаяОбработка = Ложь;
    
    Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
    Диалог.Расширение = "docx";
    Диалог.Фильтр = НСтр("ru = 'Документ Word (*.docx)|*.docx|PDF (*.pdf)|*.pdf|Word 97-2003 (*.doc)|*.doc|RTF (*.rtf)|*.rtf|HTML (*.html)|*.html|Текст (*.txt)|*.txt'");
    
    Если НЕ ПустаяСтрока(ПутьФайлаРезультата) Тогда
        Диалог.ПолноеИмяФайла = ПутьФайлаРезультата;
    КонецЕсли;
    
    Диалог.Заголовок = "Сохранение: Путь файла результата";
    
    Если Диалог.Выбрать() Тогда
        ПутьФайлаРезультата = Диалог.ПолноеИмяФайла;
    КонецЕсли;
    
КонецПроцедуры

&НаКлиенте
Процедура ПутьКШаблонуНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
    
    СтандартнаяОбработка = Ложь;
    
    Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
    Диалог.МножественныйВыбор = Ложь;
    Диалог.Фильтр = НСтр("ru = 'Шаблон Word (*.dotx;*.dot)|*.dotx;*.dot|Документ Word (*.docx;*.doc)|*.docx;*.doc'");
    
    Если НЕ ПустаяСтрока(ПутьКШаблону) Тогда
        Диалог.ПолноеИмяФайла = ПутьКШаблону;
    КонецЕсли;
    
    Диалог.Заголовок = "Открытие: Путь к шаблону";
    
    Если Диалог.Выбрать() Тогда
        ПутьКШаблону = Диалог.ПолноеИмяФайла;
    КонецЕсли;
    
КонецПроцедуры

&НаКлиенте
Процедура БазовыйКаталогНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
    
    СтандартнаяОбработка = Ложь;
    
    Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
    
    Если НЕ ПустаяСтрока(БазовыйКаталог) Тогда
        Диалог.Каталог = БазовыйКаталог;
    КонецЕсли;
    
    Диалог.Заголовок = "Выбор папки: Базовый каталог";
    
    Если Диалог.Выбрать() Тогда
        БазовыйКаталог = Диалог.Каталог;
    КонецЕсли;
    
КонецПроцедуры

#КонецОбласти

#Область МаппингФормыИНастроек

// Собирает настройки конвертации из реквизитов формы (клиентский контекст).
// Дефолты берутся из полей формы - форма всегда заполнена
// (ПриСозданииНаСервере), поэтому незаполненное поле означает осознанный выбор.
Функция НастройкиИзДанныхФормы()
    
    Настройки = Новый Структура;
    
    Замены = Новый Массив;
    Для Каждого СтрокаТаблицы Из ТаблицаЗамен Цикл
        Если ПустаяСтрока(СтрокаТаблицы.Шаблон) Тогда
            Продолжить;
        КонецЕсли;
        Замены.Добавить(НоваяЗамена(СтрокаТаблицы.Шаблон, СтрокаТаблицы.Значение,
            СтрокаТаблицы.ЭтоРегулярное, СтрокаТаблицы.УчитыватьРегистр));
    КонецЦикла;
    Настройки.Вставить("ЗаменыПередРазбором", Замены);
    
    СтилиЗаголовков = Новый Соответствие;
    Для Каждого СтрокаТаблицы Из ТаблицаСтилейЗаголовков Цикл
        
        Уровень = СтрокаТаблицы.Уровень;
        Стиль = СокрЛП(СтрокаТаблицы.Стиль);
        
        Если Уровень < 1 Или Уровень > 6 Или Стиль = "" Тогда
            Продолжить;
        КонецЕсли;
        
        Попытка
            СтилиЗаголовков.Вставить(Уровень, Число(Стиль));
        Исключение
            СтилиЗаголовков.Вставить(Уровень, Стиль);
        КонецПопытки;
        
    КонецЦикла;
    Настройки.Вставить("СтилиЗаголовков", СтилиЗаголовков);
    
    Настройки.Вставить("ПутьКШаблону", ПутьКШаблону);
    Настройки.Вставить("ШрифтТекста", Новый Структура("Имя, Размер",
        ?(ПустаяСтрока(ШрифтТекстаИмя), "Calibri", ШрифтТекстаИмя),
        ?(ШрифтТекстаРазмер = 0, 11, ШрифтТекстаРазмер)));
    Настройки.Вставить("ПараметрыСтрочногоКода", Новый Структура("ИмяШрифта, Размер",
        ?(ПустаяСтрока(ШрифтКодаИмя), "Consolas", ШрифтКодаИмя),
        ?(ШрифтКодаРазмер = 0, 10, ШрифтКодаРазмер)));
    Настройки.Вставить("ПараметрыБлокаКода", Новый Структура("ИмяШрифта, Размер, Отступ, ЗаливатьФон, ЦветФона",
        ?(ПустаяСтрока(ШрифтКодаИмя), "Consolas", ШрифтКодаИмя),
        ?(ШрифтКодаРазмер = 0, 10, ШрифтКодаРазмер),
        ?(ОтступБлокаКода = 0, 14, ОтступБлокаКода),
        ЗаливатьФонКода,
        ЦветWordИзСтроки(?(ПустаяСтрока(ЦветФонаКода), "242, 242, 242", ЦветФонаКода))));
    Настройки.Вставить("ПараметрыЦитаты", Новый Структура("Отступ, Курсив, ЛеваяЛиния, ЦветФона",
        ?(ОтступЦитаты = 0, 18, ОтступЦитаты), ЦитатыКурсивом, ЦитатыЛеваяЛиния,
        ЦветWordИзСтроки(?(ПустаяСтрока(ЦветФонаЦитаты), "242, 242, 242", ЦветФонаЦитаты))));
    Настройки.Вставить("ПараметрыТаблицы", Новый Структура("ЦветШапки",
        ЦветWordИзСтроки(?(ПустаяСтрока(ЦветШапкиТаблицы), "217, 217, 217", ЦветШапкиТаблицы))));
    Настройки.Вставить("ИспользоватьСпискиWord", ИспользоватьСпискиWord);
    Настройки.Вставить("ШагОтступаСписка", ?(ШагОтступаСписка = 0, 18, ШагОтступаСписка));
    Настройки.Вставить("ПробеловНаУровеньВложенности", Макс(Число(ПробеловНаУровень), 1));
    Настройки.Вставить("БазовыйКаталог", БазовыйКаталог);
    Настройки.Вставить("ИнтервалПослеАбзаца", Макс(ИнтервалПослеАбзаца, 0));
    Настройки.Вставить("МаксимальнаяШиринаКартинки", Макс(МаксимальнаяШиринаКартинки, 0));
    Настройки.Вставить("ПоказатьДокумент", ПоказатьДокумент);
    
    // Математические символы - только сервисный состав (пользовательская
    // настройка через форму не предусмотрена; расширение - по образцу Замены).
    Настройки.Вставить("МатематическиеСимволы", МатематическиеСимволы());   
	Настройки.Вставить("ВыступМаркера", 18);
    
    Возврат Настройки;
    
КонецФункции

// Формирует набор замен LaTeX-команда -> Unicode-символ.
// Дублирует серверный дефолт НастройкиПоУмолчанию (модуль объекта):
// таблица используется в клиентском конвейере.
Функция МатематическиеСимволы()
    
    СимволыМатематика = Новый Массив;
    СимволыМатематика.Добавить(НоваяЗамена("\rightarrow",	"→"));
    СимволыМатематика.Добавить(НоваяЗамена("\leftarrow",	"←"));
    СимволыМатематика.Добавить(НоваяЗамена("\varepsilon",	"ε"));
    СимволыМатематика.Добавить(НоваяЗамена("\epsilon",		"ε"));
    СимволыМатематика.Добавить(НоваяЗамена("\infty",		"∞"));
    СимволыМатематика.Добавить(НоваяЗамена("\neq",		"≠"));
    СимволыМатематика.Добавить(НоваяЗамена("\geq",		"≥"));
    СимволыМатематика.Добавить(НоваяЗамена("\leq",		"≤"));
    СимволыМатематика.Добавить(НоваяЗамена("\int",		"∫"));
    СимволыМатематика.Добавить(НоваяЗамена("\ne",		"≠"));
    СимволыМатематика.Добавить(НоваяЗамена("\ge",		"≥"));
    СимволыМатематика.Добавить(НоваяЗамена("\le",		"≤"));
    СимволыМатематика.Добавить(НоваяЗамена("\in",		"∈"));
    СимволыМатематика.Добавить(НоваяЗамена("\to",		"→"));
    СимволыМатематика.Добавить(НоваяЗамена("\alpha",	"α"));
    СимволыМатематика.Добавить(НоваяЗамена("\beta",		"β"));
    СимволыМатематика.Добавить(НоваяЗамена("\gamma",	"γ"));
    СимволыМатематика.Добавить(НоваяЗамена("\delta",	"δ"));
    СимволыМатематика.Добавить(НоваяЗамена("\Delta",	"Δ"));
    СимволыМатематика.Добавить(НоваяЗамена("\theta",	"θ"));
    СимволыМатематика.Добавить(НоваяЗамена("\lambda",	"λ"));
    СимволыМатематика.Добавить(НоваяЗамена("\mu",		"μ"));
    СимволыМатематика.Добавить(НоваяЗамена("\nu",		"ν"));
    СимволыМатематика.Добавить(НоваяЗамена("\pi",		"π"));
    СимволыМатематика.Добавить(НоваяЗамена("\rho",		"ρ"));
    СимволыМатематика.Добавить(НоваяЗамена("\sigma",	"σ"));
    СимволыМатематика.Добавить(НоваяЗамена("\Sigma",	"Σ"));
    СимволыМатематика.Добавить(НоваяЗамена("\tau",		"τ"));
    СимволыМатематика.Добавить(НоваяЗамена("\phi",		"φ"));
    СимволыМатематика.Добавить(НоваяЗамена("\psi",		"ψ"));
    СимволыМатематика.Добавить(НоваяЗамена("\omega",	"ω"));
    СимволыМатематика.Добавить(НоваяЗамена("\ell",		"ℓ"));
    СимволыМатематика.Добавить(НоваяЗамена("\approx",	"≈"));
    СимволыМатематика.Добавить(НоваяЗамена("\times",	"×"));
    СимволыМатематика.Добавить(НоваяЗамена("\cdot",		"·"));
    СимволыМатематика.Добавить(НоваяЗамена("\pm",		"±"));
    СимволыМатематика.Добавить(НоваяЗамена("\partial",	"∂"));
    СимволыМатематика.Добавить(НоваяЗамена("\nabla",	"∇"));
    СимволыМатематика.Добавить(НоваяЗамена("\max",		"max"));
    СимволыМатематика.Добавить(НоваяЗамена("\min",		"min"));
    СимволыМатематика.Добавить(НоваяЗамена("\exp",		"exp"));
    СимволыМатематика.Добавить(НоваяЗамена("\log",		"log"));
    СимволыМатематика.Добавить(НоваяЗамена("\|",		"‖"));
    СимволыМатематика.Добавить(НоваяЗамена("\{",		"{"));
    СимволыМатематика.Добавить(НоваяЗамена("\}",		"}"));
    СимволыМатематика.Добавить(НоваяЗамена("\%",		"%"));
    СимволыМатематика.Добавить(НоваяЗамена("-",		"−"));
    Возврат СимволыМатематика;
    
КонецФункции

&НаСервере
Процедура ЗаполнитьФормуНаСервере(Знач Настройки = Неопределено)
    
    Если Настройки = Неопределено Тогда
        Настройки = РеквизитФормыВЗначение("Объект").НастройкиПоУмолчанию();
    КонецЕсли;
    ЗаполнитьФормуПоНастройкам(Настройки);
    
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьФормуПоНастройкам(Знач Настройки)
    
    лОбъект = РеквизитФормыВЗначение("Объект");
    Данные = лОбъект.ДанныеФормыИзНастроек(Настройки);
    
    ТаблицаЗамен.Очистить();
    ТаблицаЗамен.Загрузить(Данные.ТаблицаЗамен);
    
    ТаблицаСтилейЗаголовков.Очистить();
    ТаблицаСтилейЗаголовков.Загрузить(Данные.ТаблицаСтилейЗаголовков);
    
    Поля = Данные.Поля;
    
    ШрифтТекстаИмя = Поля.ШрифтТекстаИмя;
    ШрифтТекстаРазмер = Поля.ШрифтТекстаРазмер;
    ШрифтКодаИмя = Поля.ШрифтКодаИмя;
    ШрифтКодаРазмер = Поля.ШрифтКодаРазмер;
    ОтступБлокаКода = Поля.ОтступБлокаКода;
    ЗаливатьФонКода = Поля.ЗаливатьФонКода;
    ЦветФонаКода = Поля.ЦветФонаКода;
    ОтступЦитаты = Поля.ОтступЦитаты;
    ЦитатыКурсивом = Поля.ЦитатыКурсивом;
    ЦитатыЛеваяЛиния = Поля.ЦитатыЛеваяЛиния;
    ЦветФонаЦитаты = Поля.ЦветФонаЦитаты;
    ЦветШапкиТаблицы = Поля.ЦветШапкиТаблицы;
    ИспользоватьСпискиWord = Поля.ИспользоватьСпискиWord;
    ШагОтступаСписка = Поля.ШагОтступаСписка;
    ПробеловНаУровень = Поля.ПробеловНаУровень;
    ИнтервалПослеАбзаца = Поля.ИнтервалПослеАбзаца;
    МаксимальнаяШиринаКартинки = Поля.МаксимальнаяШиринаКартинки;
    ПоказатьДокумент = Поля.ПоказатьДокумент;
    БазовыйКаталог = Поля.БазовыйКаталог;
    ПутьКШаблону = Поля.ПутьКШаблону;
    
КонецПроцедуры

#КонецОбласти

#Область КонвейерКонвертации

// Конвертирует текст Markdown в документ Word. Клиентский контекст:
// Word открывается на компьютере пользователя, пути - локальные.
//
// Параметры:
//   ТекстMarkdown - Строка    - исходный текст;
//   ПутьКФайлу    - Строка    - путь сохранения (docx/doc/pdf/rtf/html/txt);
//   Настройки     - Структура - настройки конвертации.
//
Процедура КонвертироватьВWord(Знач ТекстMarkdown, Знач ПутьКФайлу, Знач Настройки)
    
    Если НЕ Настройки.ПоказатьДокумент И ПустаяСтрока(ПутьКФайлу) Тогда
        ВызватьИсключение НСтр("ru = 'Не задан путь к файлу результата при отключенном показе документа.'");
    КонецЕсли;
    
    Текст = СтрЗаменить(ТекстMarkdown, Символы.ВК + Символы.ПС, Символы.ПС);
    Текст = СтрЗаменить(Текст, Символы.ВК, Символы.ПС);
    Текст = ВыполнитьЗамены(Текст, Настройки.ЗаменыПередРазбором);
    
    ЭлементыДокумента = РазобратьMarkdown(Текст, Настройки.ПробеловНаУровеньВложенности);
    
    Попытка
        Word = Новый COMОбъект("Word.Application");
    Исключение
        ВызватьИсключение НСтр("ru = 'Не удалось запустить Microsoft Word: '")
            + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
    КонецПопытки;
    
    Word.Visible = Ложь;
    Word.DisplayAlerts = 0;
    Word.ScreenUpdating = Ложь;
    
    ПрежниеЗначенияАвтозамен = ОтключитьАвтозаменыWord(Word);
    
    Попытка
        
        Если ЗначениеЗаполнено(Настройки.ПутьКШаблону) Тогда
            Документ = Word.Documents.Add(Настройки.ПутьКШаблону);
        Иначе
            Документ = Word.Documents.Add();
        КонецЕсли;
        
        ВывестиЭлементы(Word, Документ, ЭлементыДокумента, Настройки);
        
        Word.ScreenUpdating = Истина;
        
        Если ЗначениеЗаполнено(ПутьКФайлу) Тогда
            ФорматФайла = ФорматФайлаПоРасширению(ПутьКФайлу);
            Попытка
                Документ.SaveAs2(ПутьКФайлу, ФорматФайла);
            Исключение
                Документ.SaveAs(ПутьКФайлу, ФорматФайла);
            КонецПопытки;
        КонецЕсли;
        
        Если Настройки.ПоказатьДокумент Тогда
            ВосстановитьАвтозаменыWord(Word, ПрежниеЗначенияАвтозамен);
            Word.Visible = Истина;
            Word.Activate();
        Иначе
            Документ.Close(0);
            ВосстановитьАвтозаменыWord(Word, ПрежниеЗначенияАвтозамен);
            Word.Quit(0);
        КонецЕсли;
        
    Исключение
        
        Попытка
            ВосстановитьАвтозаменыWord(Word, ПрежниеЗначенияАвтозамен);
            Word.ScreenUpdating = Истина;
            Word.Quit(0);
        Исключение
        КонецПопытки;
        ВызватьИсключение НСтр("ru = 'Ошибка формирования документа Word: '")
            + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
        
    КонецПопытки;
    
КонецПроцедуры

// Применяет набор замен к тексту.
Функция ВыполнитьЗамены(Знач Текст, Знач Замены)
    
    RegExp = Неопределено;
    
    Для Каждого Замена Из Замены Цикл
        
        Если ПустаяСтрока(Замена.Шаблон) Тогда
            Продолжить;
        КонецЕсли;
        
        Если Замена.ЭтоРегулярное Тогда
            
            Если RegExp = Неопределено Тогда
                RegExp = Новый COMОбъект("VBScript.RegExp");
                RegExp.Global = Истина;
                RegExp.MultiLine = Истина;
            КонецЕсли;
            
            RegExp.IgnoreCase = НЕ Замена.УчитыватьРегистр;
            
            Попытка
                RegExp.Pattern = Замена.Шаблон;
            Исключение
                ВызватьИсключение НСтр("ru = 'Некорректный шаблон регулярного выражения: '") + Замена.Шаблон;
            КонецПопытки;
            
            Текст = RegExp.Replace(Текст, Замена.Значение);
            
        Иначе
            Текст = СтрЗаменить(Текст, Замена.Шаблон, Замена.Значение);
        КонецЕсли;
        
    КонецЦикла;
    
    Возврат Текст;
    
КонецФункции

#КонецОбласти

#Область РазборMarkdown

Функция РазобратьMarkdown(Знач Текст, Знач ПробеловНаУровень = 2)
    
    ЭлементыДокумента = Новый Массив;
    Строки = СтрРазделить(Текст, Символы.ПС, Истина);
    
    Индекс = 0;
    Всего = Строки.Количество();
    
    Пока Индекс < Всего Цикл
        
        ИсходнаяСтрока = Строки[Индекс];
        Строка = СокрЛП(ИсходнаяСтрока);
        
        Если Строка = "" Тогда
            Индекс = Индекс + 1;
            Продолжить;
        КонецЕсли;
        
        Если СтрНачинаетсяС(Строка, "```") Тогда
            
            ЯзыкКода = СокрЛП(Сред(Строка, 4));
            
            Индекс = Индекс + 1;
            СтрокиКода = Новый Массив;
            Пока Индекс < Всего И НЕ СтрНачинаетсяС(СокрЛП(Строки[Индекс]), "```") Цикл
                СтрокиКода.Добавить(Строки[Индекс]);
                Индекс = Индекс + 1;
            КонецЦикла;
            Индекс = Индекс + 1;
            
            Элемент = НовыйЭлемент("БлокКода", СтрСоединить(СтрокиКода, Символы.ПС));
            Элемент.ЯзыкКода = ЯзыкКода;
            ЭлементыДокумента.Добавить(Элемент);
            Продолжить;
            
        КонецЕсли;
        
        Если СтрНачинаетсяС(Строка, "#") Тогда
            
            Уровень = 0;
            Пока Уровень < 6 И Сред(Строка, Уровень + 1, 1) = "#" Цикл
                Уровень = Уровень + 1;
            КонецЦикла;
            
            ТекстЗаголовка = СокрЛП(Сред(Строка, Уровень + 1));
            Если ТекстЗаголовка <> "" Тогда
                Элемент = НовыйЭлемент("Заголовок", ТекстЗаголовка);
                Элемент.Уровень = Уровень;
                ЭлементыДокумента.Добавить(Элемент);
            КонецЕсли;
            
            Индекс = Индекс + 1;
            Продолжить;
            
        КонецЕсли;
        
        Если ЭтоГоризонтальнаяЛиния(Строка) Тогда
            ЭлементыДокумента.Добавить(НовыйЭлемент("Линия", ""));
            Индекс = Индекс + 1;
            Продолжить;
        КонецЕсли;
        
        Если СтрНачинаетсяС(Строка, "|")
            И Индекс + 1 < Всего
            И ЭтоРазделительТаблицы(СокрЛП(Строки[Индекс + 1])) Тогда
            
            Заголовки = РазобратьЯчейкиТаблицы(Строка);
            Индекс = Индекс + 2;
            
            СтрокиТаблицы = Новый Массив;
            Пока Индекс < Всего Цикл
                СтрокаТаблицы = СокрЛП(Строки[Индекс]);
                Если СтрокаТаблицы = "" ИЛИ НЕ СтрНачинаетсяС(СтрокаТаблицы, "|") Тогда
                    Прервать;
                КонецЕсли;
                СтрокиТаблицы.Добавить(РазобратьЯчейкиТаблицы(СтрокаТаблицы));
                Индекс = Индекс + 1;
            КонецЦикла;
            
            Элемент = НовыйЭлемент("Таблица", "");
            Элемент.Заголовки = Заголовки;
            Элемент.Строки = СтрокиТаблицы;
            ЭлементыДокумента.Добавить(Элемент);
            Продолжить;
            
        КонецЕсли;
        
        Список = РазобратьЭлементСписка(ИсходнаяСтрока, ПробеловНаУровень);
        Если Список.ЭтоСписок Тогда
            Элемент = НовыйЭлемент("ЭлементСписка", Список.Текст);
            Элемент.УровеньСписка = Список.Уровень;
            Элемент.ЭтоНумерованный = Список.Нумерованный;
            Элемент.Номер = Список.Номер;
            ЭлементыДокумента.Добавить(Элемент);
            Индекс = Индекс + 1;
            Продолжить;
        КонецЕсли;
        
        Если СтрНачинаетсяС(Строка, ">") Тогда
            
            ТекстЦитаты = Сред(Строка, 2);
            Индекс = Индекс + 1;
            
            Пока Индекс < Всего Цикл
                Следующая = СокрЛП(Строки[Индекс]);
                Если НЕ СтрНачинаетсяС(Следующая, ">") Тогда
                    Прервать;
                КонецЕсли;
                ТекстЦитаты = ТекстЦитаты + Символы.ПС + Сред(Следующая, 2);
                Индекс = Индекс + 1;
            КонецЦикла;
            
            ЭлементыДокумента.Добавить(НовыйЭлемент("Цитата", СокрЛП(ТекстЦитаты)));
            Продолжить;
            
        КонецЕсли;
        
        ТекстАбзаца = Строка;
        Индекс = Индекс + 1;
        
        Пока Индекс < Всего Цикл
            Следующая = СокрЛП(Строки[Индекс]);
            Если Следующая = "" ИЛИ ЭтоНачалоБлока(Следующая, ПробеловНаУровень) Тогда
                Прервать;
            КонецЕсли;
            ТекстАбзаца = ТекстАбзаца + " " + Следующая;
            Индекс = Индекс + 1;
        КонецЦикла;
        
        ЭлементыДокумента.Добавить(НовыйЭлемент("Абзац", ТекстАбзаца));
        
    КонецЦикла;
    
    Возврат ЭлементыДокумента;
    
КонецФункции

Функция ЭтоНачалоБлока(Знач Строка, Знач ПробеловНаУровень = 2)
    
    Если СтрНачинаетсяС(Строка, "#")
        ИЛИ СтрНачинаетсяС(Строка, ">")
        ИЛИ СтрНачинаетсяС(Строка, "```")
        ИЛИ СтрНачинаетсяС(Строка, "|") Тогда
        Возврат Истина;
    КонецЕсли;
    
    Если ЭтоГоризонтальнаяЛиния(Строка) Тогда
        Возврат Истина;
    КонецЕсли;
    
    Возврат РазобратьЭлементСписка(Строка, ПробеловНаУровень).ЭтоСписок;
    
КонецФункции

Функция ЭтоГоризонтальнаяЛиния(Знач Строка)
    
    Строка = СтрЗаменить(Строка, " ", "");
    
    Если СтрДлина(Строка) < 3 Тогда
        Возврат Ложь;
    КонецЕсли;
    
    ПервыйСимвол = Лев(Строка, 1);
    Если ПервыйСимвол <> "-" И ПервыйСимвол <> "*" И ПервыйСимвол <> "_" Тогда
        Возврат Ложь;
    КонецЕсли;
    
    Для Ном = 1 По СтрДлина(Строка) Цикл
        Если Сред(Строка, Ном, 1) <> ПервыйСимвол Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЦикла;
    
    Возврат Истина;
    
КонецФункции

Функция РазобратьЭлементСписка(Знач Строка, Знач ПробеловНаУровень = 2)
    
    Результат = Новый Структура("ЭтоСписок, Нумерованный, Номер, Уровень, Текст",
        Ложь, Ложь, 0, 1, "");
    
    Отступ = 0;
    Позиция = 1;
    Длина = СтрДлина(Строка);
    
    Пока Позиция <= Длина Цикл
        Символ = Сред(Строка, Позиция, 1);
        Если Символ = Символы.Таб Тогда
            Отступ = Отступ + 2;
        ИначеЕсли Символ = " " Тогда
            Отступ = Отступ + 1;
        Иначе
            Прервать;
        КонецЕсли;
        Позиция = Позиция + 1;
    КонецЦикла;
    
    Остаток = Сред(Строка, Позиция);
    
    Если СтрНачинаетсяС(Остаток, "- ")
        ИЛИ СтрНачинаетсяС(Остаток, "* ")
        ИЛИ СтрНачинаетсяС(Остаток, "+ ") Тогда
        Результат.ЭтоСписок = Истина;
        Результат.Текст = Сред(Остаток, 3);
    Иначе
        
        НомерСтрокой = "";
        Поз = 1;
        Пока Поз <= СтрДлина(Остаток) Цикл
            Символ = Сред(Остаток, Поз, 1);
            Если Символ >= "0" И Символ <= "9" Тогда
                НомерСтрокой = НомерСтрокой + Символ;
            Иначе
                Прервать;
            КонецЕсли;
            Поз = Поз + 1;
        КонецЦикла;
        
        Если НомерСтрокой <> ""
            И (СтрНачинаетсяС(Сред(Остаток, Поз), ". ") ИЛИ СтрНачинаетсяС(Сред(Остаток, Поз), ") ")) Тогда
            Результат.ЭтоСписок = Истина;
            Результат.Нумерованный = Истина;
            Результат.Номер = Число(НомерСтрокой);
            Результат.Текст = Сред(Остаток, Поз + 2);
        КонецЕсли;
        
    КонецЕсли;
    
    Если Результат.ЭтоСписок Тогда
        Результат.Уровень = Цел(Отступ / Макс(ПробеловНаУровень, 1)) + 1;
    КонецЕсли;
    
    Возврат Результат;
    
КонецФункции

Функция ЭтоРазделительТаблицы(Знач Строка)
    
    БезРазделителей = СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(Строка, "-", ""), "|", ""), ":", ""), " ", "");
    Возврат БезРазделителей = "" И СтрНайти(Строка, "-") > 0;
КонецФункции

Функция РазобратьЯчейкиТаблицы(Знач Строка)
    
    Заглушка = Символ(31);
    Строка = СтрЗаменить(Строка, "\|", Заглушка);
    
    Если СтрНачинаетсяС(Строка, "|") Тогда
        Строка = Сред(Строка, 2);
    КонецЕсли;
    Если СтрЗаканчиваетсяНа(Строка, "|") Тогда
        Строка = Лев(Строка, СтрДлина(Строка) - 1);
    КонецЕсли;
    
    Ячейки = Новый Массив;
    Для Каждого Ячейка Из СтрРазделить(Строка, "|", Истина) Цикл
        Ячейки.Добавить(СокрЛП(СтрЗаменить(Ячейка, Заглушка, "|")));
    КонецЦикла;
    
    Возврат Ячейки;
    
КонецФункции

Функция НовыйЭлемент(ТипЭлемента, Текст)
    
    Элемент = Новый Структура;
    Элемент.Вставить("Тип", ТипЭлемента);
    Элемент.Вставить("Текст", Текст);
    Элемент.Вставить("Уровень", 0);
    Элемент.Вставить("УровеньСписка", 1);
    Элемент.Вставить("ЭтоНумерованный", Ложь);
    Элемент.Вставить("Номер", 0);
    Элемент.Вставить("ЯзыкКода", "");
    Элемент.Вставить("Заголовки", Неопределено);
    Элемент.Вставить("Строки", Неопределено);
    Возврат Элемент;
    
КонецФункции

#КонецОбласти

#Область РазборВнутреннегоФорматирования

Функция РазобратьВнутреннееФорматирование(Знач Строка)
    
    Фрагменты = Новый Массив;
    
    Жирный = Ложь;
    Курсив = Ложь;
    Моноширинный = Ложь;
    Зачеркнутый = Ложь;
    Накоплено = "";
    
    Позиция = 1;
    Длина = СтрДлина(Строка);
    
    Пока Позиция <= Длина Цикл
        
        Символ = Сред(Строка, Позиция, 1);
        
        // $формула$ и $$формула$$ - математика; прозрачно для экранирования
        // и маркеров (выносится целиком, до разбора). В строчном коде - нет.
        Если Символ = "$" И НЕ Моноширинный Тогда
            
            Дисплейная = Сред(Строка, Позиция + 1, 1) = "$";
            ДлинаОткрывающего = ?(Дисплейная, 2, 1);
            ПозицияЗакрывающего = СтрНайти(Строка, ?(Дисплейная, "$$", "$"),
                НаправлениеПоиска.СНачала, Позиция + ДлинаОткрывающего);
            
            ЭтоФормула = Ложь;
            Если ПозицияЗакрывающего > 0 Тогда
                Содержимое = Сред(Строка, Позиция + ДлинаОткрывающего,
                    ПозицияЗакрывающего - Позиция - ДлинаОткрывающего);
                Если Содержимое <> ""
                    И Сред(Строка, Позиция + ДлинаОткрывающего, 1) <> " "
                    И Сред(Строка, ПозицияЗакрывающего - 1, 1) <> " " Тогда
                    ЭтоФормула = Истина;
                КонецЕсли;
            КонецЕсли;
            
            Если ЭтоФормула Тогда
                ЗафиксироватьФрагмент(Фрагменты, Накоплено, Жирный, Курсив, Моноширинный, Зачеркнутый);
                Накоплено = "";
                Фрагмент = НовыйФрагмент(Содержимое, Жирный, Курсив, Моноширинный, Зачеркнутый);
                Фрагмент.ЭтоФормула = Истина;
                Фрагменты.Добавить(Фрагмент);
                Позиция = ПозицияЗакрывающего + ДлинаОткрывающего;
            Иначе
                Накоплено = Накоплено + "$";
                Позиция = Позиция + 1;
            КонецЕсли;
            Продолжить;
            
        КонецЕсли;
        
        Если Символ = "\" И Позиция < Длина Тогда
            Накоплено = Накоплено + Сред(Строка, Позиция + 1, 1);
            Позиция = Позиция + 2;
            Продолжить;
        КонецЕсли;
        
        Если Символ = "*" Тогда
            
            Двойной      = Сред(Строка, Позиция + 1, 1) = "*";
            ДлинаМаркера = ?(Двойной, 2, 1);
            Включен      = ?(Двойной, Жирный, Курсив);
            
            Слева  = ?(Позиция > 1, Сред(Строка, Позиция - 1, 1), " ");
            Справа = Сред(Строка, Позиция + ДлинаМаркера, 1);
            
            ЭтоОткрытие = НЕ Включен И Справа <> "" И Справа <> " ";
            ЭтоЗакрытие = Включен И Слева <> " ";
            
            Если ЭтоОткрытие Или ЭтоЗакрытие Тогда
                ЗафиксироватьФрагмент(Фрагменты, Накоплено, Жирный, Курсив, Моноширинный, Зачеркнутый);
                Накоплено = "";
                Если Двойной Тогда
                    Жирный = НЕ Жирный;
                Иначе
                    Курсив = НЕ Курсив;
                КонецЕсли;
            Иначе
                Накоплено = Накоплено + ?(Двойной, "**", "*");
            КонецЕсли;
            
            Позиция = Позиция + ДлинаМаркера;
            Продолжить;
            
        КонецЕсли;
        
        Если Символ = "~" И Сред(Строка, Позиция + 1, 1) = "~" Тогда
            
            Слева  = ?(Позиция > 1, Сред(Строка, Позиция - 1, 1), " ");
            Справа = Сред(Строка, Позиция + 2, 1);
            
            ЭтоОткрытие = НЕ Зачеркнутый И Справа <> "" И Справа <> " ";
            ЭтоЗакрытие = Зачеркнутый И Слева <> " ";
            
            Если ЭтоОткрытие Или ЭтоЗакрытие Тогда
                ЗафиксироватьФрагмент(Фрагменты, Накоплено, Жирный, Курсив, Моноширинный, Зачеркнутый);
                Накоплено = "";
                Зачеркнутый = НЕ Зачеркнутый;
            Иначе
                Накоплено = Накоплено + "~~";
            КонецЕсли;
            
            Позиция = Позиция + 2;
            Продолжить;
            
        КонецЕсли;
        
        Если Символ = "`" Тогда
            ЗафиксироватьФрагмент(Фрагменты, Накоплено, Жирный, Курсив, Моноширинный, Зачеркнутый);
            Накоплено = "";
            Моноширинный = НЕ Моноширинный;
            Позиция = Позиция + 1;
            Продолжить;
        КонецЕсли;
        
        Если Символ = "[" ИЛИ Символ = "!" Тогда
            Ссылка = РазобратьСсылкуИлиКартинку(Строка, Позиция);
            Если Ссылка <> Неопределено Тогда
                ЗафиксироватьФрагмент(Фрагменты, Накоплено, Жирный, Курсив, Моноширинный, Зачеркнутый);
                Накоплено = "";
                Фрагмент = НовыйФрагмент(Ссылка.Текст, Жирный, Курсив, Моноширинный, Зачеркнутый);
                Если Ссылка.ЭтоКартинка Тогда
                    Фрагмент.ПутьККартинке = Ссылка.Адрес;
                Иначе
                    Фрагмент.АдресСсылки = Ссылка.Адрес;
                КонецЕсли;
                Фрагменты.Добавить(Фрагмент);
                Позиция = Ссылка.ПозицияПосле;
                Продолжить;
            КонецЕсли;
        КонецЕсли;
        
        Накоплено = Накоплено + Символ;
        Позиция = Позиция + 1;
        
    КонецЦикла;
    
    ЗафиксироватьФрагмент(Фрагменты, Накоплено, Жирный, Курсив, Моноширинный, Зачеркнутый);
    
    Возврат Фрагменты;
    
КонецФункции

Функция РазобратьСсылкуИлиКартинку(Знач Строка, Знач Позиция)
    
    ЭтоКартинка = Сред(Строка, Позиция, 2) = "![";
    ПозицияСкобки = ?(ЭтоКартинка, Позиция + 1, Позиция);
    
    Если Сред(Строка, ПозицияСкобки, 1) <> "[" Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    ПозицияЗакрывающей = СтрНайти(Строка, "]", НаправлениеПоиска.СНачала, ПозицияСкобки + 1);
    Если ПозицияЗакрывающей = 0 ИЛИ Сред(Строка, ПозицияЗакрывающей + 1, 1) <> "(" Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    ПозицияКонца = СтрНайти(Строка, ")", НаправлениеПоиска.СНачала, ПозицияЗакрывающей + 2);
    Если ПозицияКонца = 0 Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    Текст = Сред(Строка, ПозицияСкобки + 1, ПозицияЗакрывающей - ПозицияСкобки - 1);
    Адрес = Сред(Строка, ПозицияЗакрывающей + 2, ПозицияКонца - ПозицияЗакрывающей - 2);
    
    Если Адрес = "" Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    Возврат Новый Структура("Текст, Адрес, ЭтоКартинка, ПозицияПосле",
        Текст, Адрес, ЭтоКартинка, ПозицияКонца + 1);
    
КонецФункции

Функция НовыйФрагмент(Текст = "", Жирный = Ложь, Курсив = Ложь, Моноширинный = Ложь, Зачеркнутый = Ложь)
    
    Возврат Новый Структура("Текст, Жирный, Курсив, Моноширинный, Зачеркнутый, АдресСсылки, ПутьККартинке, ЭтоФормула",
        Текст, Жирный, Курсив, Моноширинный, Зачеркнутый, "", "", Ложь);
    
КонецФункции

Процедура ЗафиксироватьФрагмент(Фрагменты, Текст, Жирный, Курсив, Моноширинный, Зачеркнутый)
    
    Если Текст = "" Тогда
        Возврат;
    КонецЕсли;
    
    Фрагменты.Добавить(НовыйФрагмент(Текст, Жирный, Курсив, Моноширинный, Зачеркнутый));
    
КонецПроцедуры

#КонецОбласти

#Область ВыводВДокументWord

Процедура ВывестиЭлементы(Word, Документ, ЭлементыДокумента, Настройки)
    
    ВнутриСписка = Неопределено;
    ПервыйЭлемент = Истина;
    
    СчетчикиНумерации = Новый Массив;
    Для Инд = 0 По 9 Цикл
        СчетчикиНумерации.Добавить(0);
    КонецЦикла;
    
    Для Каждого Элемент Из ЭлементыДокумента Цикл
        
        Если НЕ ПервыйЭлемент Тогда
            
            Word.Selection.TypeParagraph();
            
            Если ВнутриСписка <> Неопределено И Элемент.Тип <> "ЭлементСписка" Тогда
                Word.Selection.Range.ListFormat.RemoveNumbers();
                ВнутриСписка = Неопределено;
                СброситьСчетчикиНумерации(СчетчикиНумерации);
            КонецЕсли;
            
        КонецЕсли;
        
        СброситьФорматированиеАбзаца(Word, Настройки);
        
        Если Элемент.Тип = "ЭлементСписка" Тогда
            
            Если ВнутриСписка <> Неопределено И ВнутриСписка <> Элемент.ЭтоНумерованный Тогда
                Word.Selection.Range.ListFormat.RemoveNumbers();
                ВнутриСписка = Неопределено;
                СброситьСчетчикиНумерации(СчетчикиНумерации);
            КонецЕсли;
            
            ПрименитьФорматСписка(Word, Элемент, ВнутриСписка, Настройки);
            
            Если НЕ Настройки.ИспользоватьСпискиWord Тогда
                ВнутриСписка = Элемент.ЭтоНумерованный;
                Word.Selection.TypeText(ТекстовыйМаркерСписка(Элемент, СчетчикиНумерации));
            КонецЕсли;
            
        КонецЕсли;
        
        ВывестиЭлемент(Word, Документ, Элемент, Настройки);
        
        ПервыйЭлемент = Ложь;
        
    КонецЦикла;
    
КонецПроцедуры

Процедура ВывестиЭлемент(Word, Документ, Элемент, Настройки)
    
    Если Элемент.Тип = "Заголовок" Тогда
        
        Попытка
            Word.Selection.Style = СтильЗаголовкаWord(Элемент.Уровень, Настройки);
        Исключение
        КонецПопытки;
        ВывестиФорматированныйТекст(Word, Документ, Элемент.Текст, Настройки, Ложь);
        
    ИначеЕсли Элемент.Тип = "Абзац" ИЛИ Элемент.Тип = "ЭлементСписка" Тогда
        
        ВывестиФорматированныйТекст(Word, Документ, Элемент.Текст, Настройки, Истина);
        
    ИначеЕсли Элемент.Тип = "БлокКода" Тогда
        
        ВывестиБлокКода(Word, Документ, Элемент.Текст, Настройки);
        
    ИначеЕсли Элемент.Тип = "Цитата" Тогда
        
        ВывестиЦитату(Word, Документ, Элемент.Текст, Настройки);
        
    ИначеЕсли Элемент.Тип = "Линия" Тогда
        
        ВывестиГоризонтальнуюЛинию(Word);
        
    ИначеЕсли Элемент.Тип = "Таблица" Тогда
        
        ВывестиТаблицу(Word, Документ, Элемент, Настройки);
        
    КонецЕсли;
    
КонецПроцедуры

Процедура ВывестиФорматированныйТекст(Word, Документ, Текст, Настройки,
    Знач МенятьШрифт = Истина, Знач ПринудительныйКурсив = Ложь)
    
    Фрагменты = РазобратьВнутреннееФорматирование(Текст);
    
    Для Каждого Фрагмент Из Фрагменты Цикл
        
        Выборка = Word.Selection;
        Шрифт = Выборка.Font;
        
        Шрифт.Bold = ?(Фрагмент.Жирный, 1, 0);
        Шрифт.Italic = ?(Фрагмент.Курсив ИЛИ ПринудительныйКурсив, 1, 0);
        Шрифт.StrikeThrough = ?(Фрагмент.Зачеркнутый, 1, 0);
        Шрифт.Underline = 0;
        Шрифт.Color = -16777216;
        
        Если Фрагмент.Моноширинный Тогда
            Шрифт.Name = Настройки.ПараметрыСтрочногоКода.ИмяШрифта;
            Шрифт.Size = Настройки.ПараметрыСтрочногоКода.Размер;
        ИначеЕсли МенятьШрифт Тогда
            Шрифт.Name = Настройки.ШрифтТекста.Имя;
            Шрифт.Size = Настройки.ШрифтТекста.Размер;
        КонецЕсли;
        
        Если Фрагмент.ЭтоФормула Тогда
            ВывестиФормулу(Word, Фрагмент.Текст, Настройки);
            Продолжить;
        КонецЕсли;
        
        Если Фрагмент.ПутьККартинке <> "" Тогда
            
            Попытка
                ПолныйПуть = ПолноеИмяРесурса(Фрагмент.ПутьККартинке, Настройки.БазовыйКаталог);
                Картинка = Выборка.InlineShapes.AddPicture(ПолныйПуть, Ложь, Истина);
                Если Настройки.МаксимальнаяШиринаКартинки > 0
                    И Картинка.Width > Настройки.МаксимальнаяШиринаКартинки Тогда
                    Коэффициент = Настройки.МаксимальнаяШиринаКартинки / Картинка.Width;
                    Картинка.Height = Окр(Картинка.Height * Коэффициент);
                    Картинка.Width = Настройки.МаксимальнаяШиринаКартинки;
                КонецЕсли;
            Исключение
                Выборка.TypeText("[" + Фрагмент.Текст + "]");
            КонецПопытки;
            Продолжить;
            
        КонецЕсли;
        
        НачалоТекста = Выборка.Range.Start;
        
        Части = СтрРазделить(Фрагмент.Текст, Символы.ПС, Истина);
        Для ИндексЧасти = 0 По Части.Количество() - 1 Цикл
            Выборка.TypeText(Части[ИндексЧасти]);
            Если ИндексЧасти < Части.Количество() - 1 Тогда
                Выборка.TypeParagraph();
            КонецЕсли;
        КонецЦикла;
        
        Если Фрагмент.АдресСсылки <> "" И Выборка.Range.End > НачалоТекста Тогда
            Попытка
                ДиапазонСсылки = Документ.Range(НачалоТекста, Выборка.Range.End);
                Документ.Hyperlinks.Add(ДиапазонСсылки, Фрагмент.АдресСсылки);
            Исключение
            КонецПопытки;
        КонецЕсли;
        
    КонецЦикла;
    
КонецПроцедуры

// Выводит формулу: LaTeX-команды -> Unicode (МатематическиеСимволы),
// _{...}/_{x} и ^{...}/^{x} - подстрочным/надстрочным начертанием Word.
Процедура ВывестиФормулу(Word, ТекстФормулы, Настройки)
    
    ТекстФормулы = СнятьОформлениеТекста(ТекстФормулы);
    ТекстФормулы = ВыполнитьЗамены(ТекстФормулы, Настройки.МатематическиеСимволы);
    
    Выборка = Word.Selection;
    Шрифт = Выборка.Font;
    
    Сегменты = РазобратьФормулуНаСегменты(ТекстФормулы);
    Для Каждого Сегмент Из Сегменты Цикл
        Шрифт.Subscript   = ?(Сегмент.Режим = 1, 1, 0);
        Шрифт.Superscript = ?(Сегмент.Режим = 2, 1, 0);
        Выборка.TypeText(Сегмент.Текст);
    КонецЦикла;
    
    Шрифт.Subscript = 0;
    Шрифт.Superscript = 0;
    
КонецПроцедуры

Функция РазобратьФормулуНаСегменты(Знач Текст)
    
    Сегменты = Новый Массив;
    Обычный = "";
    Позиция = 1;
    Длина = СтрДлина(Текст);
    
    Пока Позиция <= Длина Цикл
        
        Символ = Сред(Текст, Позиция, 1);
        
        Если Символ = "_" Или Символ = "^" Тогда
            
            Если Сред(Текст, Позиция + 1, 1) = "{" Тогда
                ПозицияКонца = СтрНайти(Текст, "}", НаправлениеПоиска.СНачала, Позиция + 2);
                Если ПозицияКонца = 0 Тогда
                    ПозицияКонца = Длина + 1;
                КонецЕсли;
                Содержимое = Сред(Текст, Позиция + 2, ПозицияКонца - Позиция - 2);
                ПозицияПосле = ПозицияКонца + 1;
            Иначе
                Содержимое = Сред(Текст, Позиция + 1, 1);
                ПозицияПосле = Позиция + 2;
            КонецЕсли;
            
            Если Обычный <> "" Тогда
                Сегменты.Добавить(НовыйСегментФормулы(Обычный, 0));
                Обычный = "";
            КонецЕсли;
            Если Содержимое <> "" Тогда
                Сегменты.Добавить(НовыйСегментФормулы(Содержимое, ?(Символ = "_", 1, 2)));
            КонецЕсли;
            
            Позиция = ПозицияПосле;
            Продолжить;
            
        КонецЕсли;
        
        Обычный = Обычный + Символ;
        Позиция = Позиция + 1;
        
    КонецЦикла;
    
    Если Обычный <> "" Тогда
        Сегменты.Добавить(НовыйСегментФормулы(Обычный, 0));
    КонецЕсли;
    
    Возврат Сегменты;
    
КонецФункции

Функция НовыйСегментФормулы(Текст, Режим)
    Возврат Новый Структура("Текст, Режим", Текст, Режим);
КонецФункции

Функция СнятьОформлениеТекста(Знач Текст)
    
    Результат = "";
    Позиция = 1;
    Длина = СтрДлина(Текст);
    
    Пока Позиция <= Длина Цикл
        Если Сред(Текст, Позиция, 6) = "\text{" Или Сред(Текст, Позиция, 8) = "\mathrm{" Тогда
            ДлинаКоманды = ?(Сред(Текст, Позиция, 6) = "\text{", 6, 8);
            ПозицияКонца = СтрНайти(Текст, "}", НаправлениеПоиска.СНачала, Позиция + ДлинаКоманды);
            Если ПозицияКонца = 0 Тогда
                ПозицияКонца = Длина + 1;
            КонецЕсли;
            Результат = Результат + Сред(Текст, Позиция + ДлинаКоманды, ПозицияКонца - Позиция - ДлинаКоманды);
            Позиция = ПозицияКонца + 1;
        Иначе
            Результат = Результат + Сред(Текст, Позиция, 1);
            Позиция = Позиция + 1;
        КонецЕсли;
    КонецЦикла;
    
    Возврат Результат;
    
КонецФункции

Процедура ВывестиБлокКода(Word, Документ, ТекстКода, Настройки)
    
    ПараметрыБлока = Настройки.ПараметрыБлокаКода;
    Выборка = Word.Selection;
    
    Формат = Выборка.ParagraphFormat;
    Формат.LeftIndent = ПараметрыБлока.Отступ;
    Формат.SpaceBefore = 0;
    Формат.SpaceAfter = 0;
    
    Шрифт = Выборка.Font;
    Шрифт.Name = ПараметрыБлока.ИмяШрифта;
    Шрифт.Size = ПараметрыБлока.Размер;
    Шрифт.Bold = 0;
    Шрифт.Italic = 0;
    Шрифт.StrikeThrough = 0;
    Шрифт.Underline = 0;
    
    Начало = Выборка.Range.Start;
    
    Выборка.TypeText(СтрЗаменить(ТекстКода, Символы.ПС, Символы.ВК));
    
    Если ПараметрыБлока.ЗаливатьФон Тогда
        Диапазон = Документ.Range(Начало, Выборка.Range.End);
        Диапазон.Shading.BackgroundPatternColor = ПараметрыБлока.ЦветФона;
    КонецЕсли;
    
КонецПроцедуры

Процедура ВывестиЦитату(Word, Документ, ТекстЦитаты, Настройки)
    
    ПараметрыЦитаты = Настройки.ПараметрыЦитаты;
    Выборка = Word.Selection;
    
    Выборка.ParagraphFormat.LeftIndent = ПараметрыЦитаты.Отступ;
    
    Начало = Выборка.Range.Start;
    ВывестиФорматированныйТекст(Word, Документ, ТекстЦитаты, Настройки, Истина, ПараметрыЦитаты.Курсив);
    
    ДиапазонЦитаты = Документ.Range(Начало, Word.Selection.Range.End);
    
    Если ПараметрыЦитаты.ЦветФона > 0 Тогда
        ДиапазонЦитаты.Shading.BackgroundPatternColor = ПараметрыЦитаты.ЦветФона;
    КонецЕсли;
    
    Если ПараметрыЦитаты.ЛеваяЛиния Тогда
        
        wdBorderLeft      = -2;
        wdLineStyleSingle = 1;
        wdLineWidth075pt  = 6;
        
        Попытка
            Граница = ДиапазонЦитаты.Borders.Item(wdBorderLeft);
            Граница.LineStyle = wdLineStyleSingle;
            Граница.LineWidth = wdLineWidth075pt;
        Исключение
        КонецПопытки;
        
    КонецЕсли;
    
КонецПроцедуры


Процедура ВывестиГоризонтальнуюЛинию(Word)
    
    wdBorderBottom    = -3;
    wdLineStyleSingle = 1;
    
    Попытка
        Word.Selection.InlineShapes.AddHorizontalLineStandard();
    Исключение
        Попытка
            Граница = Word.Selection.Range.Borders.Item(wdBorderBottom);
            Граница.LineStyle = wdLineStyleSingle;
        Исключение
        КонецПопытки;
    КонецПопытки;
    
КонецПроцедуры

Процедура ВывестиТаблицу(Word, Документ, Элемент, Настройки)
    
    КоличествоКолонок = Элемент.Заголовки.Количество();
    Если КоличествоКолонок = 0 Тогда
        Возврат;
    КонецЕсли;
    
    Таблица = Документ.Tables.Add(Word.Selection.Range,
        Элемент.Строки.Количество() + 1, КоличествоКолонок);
    
    Попытка
        Таблица.Borders.Enable = Истина;
        Таблица.Range.Font.Name = Настройки.ШрифтТекста.Имя;
        Таблица.Range.Font.Size = Настройки.ШрифтТекста.Размер;
    Исключение
    КонецПопытки;
    
    wdCollapseStart = 1;
    
    Для Колонка = 0 По КоличествоКолонок - 1 Цикл
        Ячейка = Таблица.Cell(1, Колонка + 1);
        ДиапазонЯчейки = Ячейка.Range;
        ДиапазонЯчейки.Collapse(wdCollapseStart);
        ДиапазонЯчейки.Select();
        ВывестиФорматированныйТекст(Word, Документ, Элемент.Заголовки[Колонка], Настройки, Истина);
        Ячейка.Range.Bold = 1;
        Если Настройки.ПараметрыТаблицы.ЦветШапки > 0 Тогда
            Ячейка.Range.Shading.BackgroundPatternColor = Настройки.ПараметрыТаблицы.ЦветШапки;
        КонецЕсли;
    КонецЦикла;
    
    Для ИндексСтроки = 0 По Элемент.Строки.Количество() - 1 Цикл
        
        ДанныеСтроки = Элемент.Строки[ИндексСтроки];
        Для Колонка = 0 По КоличествоКолонок - 1 Цикл
            Значение = ?(Колонка < ДанныеСтроки.Количество(), ДанныеСтроки[Колонка], "");
            ДиапазонЯчейки = Таблица.Cell(ИндексСтроки + 2, Колонка + 1).Range;
            ДиапазонЯчейки.Collapse(wdCollapseStart);
            ДиапазонЯчейки.Select();
            ВывестиФорматированныйТекст(Word, Документ, Значение, Настройки, Истина);
        КонецЦикла;
        
    КонецЦикла;
    
    ДиапазонТаблицы = Таблица.Range;
    ДиапазонТаблицы.Collapse(0);
    ДиапазонТаблицы.Select();
    
КонецПроцедуры

Процедура ПрименитьФорматСписка(Word, Элемент, ВнутриСписка, Настройки)
    
    // Сначала формат списка, затем отступ (иначе Word сбросит его значением
    // по умолчанию из шаблона списка).
    Если Настройки.ИспользоватьСпискиWord И ВнутриСписка = Неопределено Тогда
        Если Элемент.ЭтоНумерованный Тогда
            Word.Selection.Range.ListFormat.ApplyNumberDefault();
        Иначе
            Word.Selection.Range.ListFormat.ApplyBulletDefault();
        КонецЕсли;
        ВнутриСписка = Элемент.ЭтоНумерованный;
    КонецЕсли;
    
    ФорматАбзаца = Word.Selection.ParagraphFormat;
    ФорматАбзаца.LeftIndent = Элемент.УровеньСписка * Настройки.ШагОтступаСписка;
    ФорматАбзаца.FirstLineIndent = -Настройки.ВыступМаркера;	// маркер левее текста
    ФорматАбзаца.SpaceAfter = 0;
    
КонецПроцедуры


Функция ТекстовыйМаркерСписка(Элемент, СчетчикиНумерации)
    
    Если НЕ Элемент.ЭтоНумерованный Тогда
        Возврат "• ";
    КонецЕсли;
    
    Уровень = Мин(Макс(Элемент.УровеньСписка, 1), СчетчикиНумерации.Количество());
    
    СчетчикиНумерации[Уровень - 1] = СчетчикиНумерации[Уровень - 1] + 1;
    Для Инд = Уровень По СчетчикиНумерации.Количество() - 1 Цикл
        СчетчикиНумерации[Инд] = 0;
    КонецЦикла;
    
    Возврат Строка(СчетчикиНумерации[Уровень - 1]) + ". ";
    
КонецФункции

Процедура СброситьСчетчикиНумерации(Счетчики)
    Для Инд = 0 По Счетчики.Количество() - 1 Цикл
        Счетчики[Инд] = 0;
    КонецЦикла;
КонецПроцедуры

Процедура СброситьФорматированиеАбзаца(Word, Настройки)
    
    Формат = Word.Selection.ParagraphFormat;
    Формат.LeftIndent = 0;
    Формат.RightIndent = 0;
    Формат.FirstLineIndent = 0;
    Формат.SpaceBefore = 0;
    Формат.SpaceAfter = Настройки.ИнтервалПослеАбзаца;
    
КонецПроцедуры

Функция СтильЗаголовкаWord(Уровень, Настройки)
    
    Стиль = Неопределено;
    
    Если Настройки.СтилиЗаголовков <> Неопределено Тогда
        Стиль = Настройки.СтилиЗаголовков.Получить(Уровень);
    КонецЕсли;
    
    Если Стиль = Неопределено Тогда
        Стиль = -1 - Уровень;
    КонецЕсли;
    
    Возврат Стиль;
    
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗагрузитьИзФайлаЗавершение(Результат, Адрес, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт
    
    Если НЕ Результат Тогда
        Возврат;
    КонецЕсли;
    
    ТекстMarkdown = ПрочитатьТекстовыйФайлНаСервере(Адрес);
    
    КаталогФайла = КаталогИзПолногоИмени(ДополнительныеПараметры.ПолноеИмяФайла);
    Если НЕ ПустаяСтрока(КаталогФайла) Тогда
        БазовыйКаталог = КаталогФайла;
    КонецЕсли;
    
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПрочитатьТекстовыйФайлНаСервере(Знач Адрес)
    
    ДвоичныеДанные = ПолучитьИзВременногоХранилища(Адрес);
    
    ИмяВременногоФайла = ПолучитьИмяВременногоФайла("md");
    ДвоичныеДанные.Записать(ИмяВременногоФайла);
    
    Кодировка = ОпределитьКодировкуФайла(ИмяВременногоФайла);
    
    ТекстовыйДокумент = Новый ТекстовыйДокумент;
    ТекстовыйДокумент.Прочитать(ИмяВременногоФайла, Кодировка);
    
    УдалитьФайлы(ИмяВременногоФайла);
    
    Возврат ТекстовыйДокумент.ПолучитьТекст();
    
КонецФункции

&НаСервереБезКонтекста
Функция ОпределитьКодировкуФайла(Знач ИмяФайла)
    
    Чтение = Новый ЧтениеДанных(ИмяФайла);
    Буфер = Чтение.ПрочитатьВБуферДвоичныхДанных(4096);
    Чтение.Закрыть();
    
    Размер = Буфер.Размер;
    
    Если Размер >= 3 И Буфер[0] = 239 И Буфер[1] = 187 И Буфер[2] = 191 Тогда
        Возврат КодировкаТекста.UTF8;
    КонецЕсли;
    Если Размер >= 2 И Буфер[0] = 255 И Буфер[1] = 254 Тогда
        Возврат КодировкаТекста.UTF16LE;
    КонецЕсли;
    Если Размер >= 2 И Буфер[0] = 254 И Буфер[1] = 255 Тогда
        Возврат КодировкаТекста.UTF16BE;
    КонецЕсли;
    
    Если ЭтоДопустимыйUTF8(Буфер) Тогда
        Возврат КодировкаТекста.UTF8;
    КонецЕсли;
    
    Возврат КодировкаТекста.ANSI;
    
КонецФункции

&НаСервереБезКонтекста
Функция ЭтоДопустимыйUTF8(Знач Буфер)
    
    Размер = Буфер.Размер;
    Индекс = 0;
    
    Пока Индекс < Размер Цикл
        
        Байт = Буфер[Индекс];
        
        Если Байт < 128 Тогда
            Индекс = Индекс + 1;
        ИначеЕсли Байт >= 194 И Байт <= 244 Тогда
            
            Если Байт <= 223 Тогда
                Длина = 2;
            ИначеЕсли Байт <= 239 Тогда
                Длина = 3;
            Иначе
                Длина = 4;
            КонецЕсли;
            
            Если Индекс + Длина > Размер Тогда
                Прервать;
            КонецЕсли;
            
            Для Смещение = 1 По Длина - 1 Цикл
                Если НЕ ЭтоБайтПродолженияUTF8(Буфер[Индекс + Смещение]) Тогда
                    Возврат Ложь;
                КонецЕсли;
            КонецЦикла;
            
            Индекс = Индекс + Длина;
            
        Иначе
            Возврат Ложь;
        КонецЕсли;
        
    КонецЦикла;
    
    Возврат Истина;
    
КонецФункции

&НаСервереБезКонтекста
Функция ЭтоБайтПродолженияUTF8(Знач Байт)
    Возврат Байт >= 128 И Байт <= 191;
КонецФункции

&НаКлиенте
Функция КаталогИзПолногоИмени(Знач ПолноеИмя)
    
    ПолноеИмя = СтрЗаменить(ПолноеИмя, "/", "\");
    
    Позиция = СтрНайти(ПолноеИмя, "\", НаправлениеПоиска.СКонца);
    Если Позиция <= 0 Тогда
        Возврат "";
    КонецЕсли;
    
    Возврат Лев(ПолноеИмя, Позиция);
    
КонецФункции

// Отключает автозамены Word "при вводе", искажающие вставляемый текст.
Функция ОтключитьАвтозаменыWord(Word)
    
    ПрежниеЗначения = Новый Структура;
    
    Попытка
        ПрежниеЗначения.Вставить("ЗаменятьТекст", Word.AutoCorrect.ReplaceText);
        Word.AutoCorrect.ReplaceText = Ложь;
    Исключение
    КонецПопытки;
    
    Попытка
        ПрежниеЗначения.Вставить("ЗаменятьКавычки", Word.Options.AutoFormatAsYouTypeReplaceQuotes);
        Word.Options.AutoFormatAsYouTypeReplaceQuotes = Ложь;
    Исключение
    КонецПопытки;
    
    Попытка
        ПрежниеЗначения.Вставить("ЗаменятьДефисы", Word.Options.AutoFormatAsYouTypeReplaceHyphens);
        Word.Options.AutoFormatAsYouTypeReplaceHyphens = Ложь;
    Исключение
    КонецПопытки;
    
    Попытка
        ПрежниеЗначения.Вставить("ЗаменятьСимволы", Word.Options.AutoFormatAsYouTypeReplaceSymbols);
        Word.Options.AutoFormatAsYouTypeReplaceSymbols = Ложь;
    Исключение
    КонецПопытки;
    
    Попытка
        ПрежниеЗначения.Вставить("ВыделениеТекста", Word.Options.AutoFormatAsYouTypeReplacePlainTextEmphasis);
        Word.Options.AutoFormatAsYouTypeReplacePlainTextEmphasis = Ложь;
    Исключение
    КонецПопытки;
    
    Попытка
        ПрежниеЗначения.Вставить("ЗаменятьСписки", Word.Options.AutoFormatAsYouTypeBulletLists);
        Word.Options.AutoFormatAsYouTypeBulletLists = Ложь;
    Исключение
    КонецПопытки;
    
    Попытка
        ПрежниеЗначения.Вставить("ЗаменятьНумерацию", Word.Options.AutoFormatAsYouTypeNumberedLists);
        Word.Options.AutoFormatAsYouTypeNumberedLists = Ложь;
    Исключение
    КонецПопытки;
    
    Попытка
        ПрежниеЗначения.Вставить("Автограницы", Word.Options.AutoFormatAsYouTypeAutoBorders);
        Word.Options.AutoFormatAsYouTypeAutoBorders = Ложь;
    Исключение
    КонецПопытки;
    
    Возврат ПрежниеЗначения;
    
КонецФункции

Процедура ВосстановитьАвтозаменыWord(Word, Знач ПрежниеЗначения)
    
    Если ПрежниеЗначения = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    Попытка
        Word.AutoCorrect.ReplaceText = ПрежниеЗначения.ЗаменятьТекст;
    Исключение
    КонецПопытки;
    
    Попытка
        Word.Options.AutoFormatAsYouTypeReplaceQuotes = ПрежниеЗначения.ЗаменятьКавычки;
    Исключение
    КонецПопытки;
    
    Попытка
        Word.Options.AutoFormatAsYouTypeReplaceHyphens = ПрежниеЗначения.ЗаменятьДефисы;
    Исключение
    КонецПопытки;
    
    Попытка
        Word.Options.AutoFormatAsYouTypeReplaceSymbols = ПрежниеЗначения.ЗаменятьСимволы;
    Исключение
    КонецПопытки;
    
    Попытка
        Word.Options.AutoFormatAsYouTypeReplacePlainTextEmphasis = ПрежниеЗначения.ВыделениеТекста;
    Исключение
    КонецПопытки;
    
    Попытка
        Word.Options.AutoFormatAsYouTypeBulletLists = ПрежниеЗначения.ЗаменятьСписки;
    Исключение
    КонецПопытки;
    
    Попытка
        Word.Options.AutoFormatAsYouTypeNumberedLists = ПрежниеЗначения.ЗаменятьНумерацию;
    Исключение
    КонецПопытки;
    
    Попытка
        Word.Options.AutoFormatAsYouTypeAutoBorders = ПрежниеЗначения.Автограницы;
    Исключение
    КонецПопытки;
    
КонецПроцедуры

Функция ПолноеИмяРесурса(Знач Путь, Знач БазовыйКаталог)
    
    Если ПустаяСтрока(Путь) Или ПустаяСтрока(БазовыйКаталог) Тогда
        Возврат Путь;
    КонецЕсли;
    
    Если СтрНачинаетсяС(Путь, "http://") Или СтрНачинаетсяС(Путь, "https://")
        Или СтрНачинаетсяС(Путь, "file:")
        Или Сред(Путь, 2, 1) = ":" Или СтрНачинаетсяС(Путь, "\\") Или СтрНачинаетсяС(Путь, "/") Тогда
        Возврат Путь;
    КонецЕсли;
    
    Разделитель = ?(СтрЗаканчиваетсяНа(БазовыйКаталог, "\"), "", "\");
    Возврат БазовыйКаталог + Разделитель + СтрЗаменить(Путь, "/", "\");
    
КонецФункции

Функция ФорматФайлаПоРасширению(Знач ПутьКФайлу)
    
    Расширение = "";
    
    Части = СтрРазделить(ПутьКФайлу, ".");
    Если Части.Количество() > 0 Тогда
        Расширение = НРег(Части[Части.Количество() - 1]);
    КонецЕсли;
    
    Если Расширение = "doc" Тогда
        Возврат 0;
    ИначеЕсли Расширение = "docx" Тогда
        Возврат 12;
    ИначеЕсли Расширение = "docm" Тогда
        Возврат 13;
    ИначеЕсли Расширение = "rtf" Тогда
        Возврат 6;
    ИначеЕсли Расширение = "pdf" Тогда
        Возврат 17;
    ИначеЕсли Расширение = "xps" Тогда
        Возврат 18;
    ИначеЕсли Расширение = "html" Или Расширение = "htm" Тогда
        Возврат 8;
    ИначеЕсли Расширение = "txt" Тогда
        Возврат 2;
    Иначе
        Возврат 16;
    КонецЕсли;
    
КонецФункции

Функция ЦветWord(Знач Красный, Знач Зеленый, Знач Синий)
    Возврат Синий * 65536 + Зеленый * 256 + Красный;
КонецФункции

// "242, 242, 242" -> значение цвета Word. Пусто или некорректно -> 0.
Функция ЦветWordИзСтроки(Знач Значение)
    
    Компоненты = СтрРазделить(СокрЛП(Значение), ",");
    Если Компоненты.Количество() <> 3 Тогда
        Возврат 0;
    КонецЕсли;
    
    Попытка
        Красный = Число(СокрЛП(Компоненты[0]));
        Зеленый = Число(СокрЛП(Компоненты[1]));
        Синий = Число(СокрЛП(Компоненты[2]));
    Исключение
        Возврат 0;
    КонецПопытки;
    
    Если Красный <> Цел(Красный) Или Зеленый <> Цел(Зеленый) Или Синий <> Цел(Синий)
        Или Красный < 0 Или Красный > 255
        Или Зеленый < 0 Или Зеленый > 255
        Или Синий < 0 Или Синий > 255 Тогда
        Возврат 0;
    КонецЕсли;
    
    Возврат ЦветWord(Красный, Зеленый, Синий);
    
КонецФункции

// Описание одной замены (клиентский аналог НовойЗамены модуля объекта).
Функция НоваяЗамена(Знач Шаблон, Знач Значение, Знач ЭтоРегулярное = Ложь, Знач УчитыватьРегистр = Ложь)
    Возврат Новый Структура("Шаблон, Значение, ЭтоРегулярное, УчитыватьРегистр",
        Шаблон, Значение, ЭтоРегулярное, УчитыватьРегистр);
КонецФункции

// Приемочный сценарий из чек-листа ревью одним текстом:
// кавычки/автозамены, незамкнутая звезда, 1. 1. 1., вложенность 2 пробелами,
// экранированный пайп, пустая ячейка, инлайн-разметка в ячейках, fallback картинки.
&НаКлиенте
Функция ТестовыйТекст()
    
    Возврат "# Приемочный тест
    |
    |Абзац: **жирный**, *курсив*, `код`, ~~зачеркнутый~~, [ссылка](https://example.com).
    |Незамкнутая звезда: цена * 5 долларов. Картинка: ![тест](pics/test.png).
    |
    |## Списки
    |
    |- первый
    |  - вложенный (2 пробела)
    |- второй
    |
    |1. один
    |1. два
    |1. три
    |
    |> Цитата с ""кавычками"", -- и (c).
    |
    |---
    |
    || Колонка | Вторая \| с пайпом |
    ||---|---|
    || **жирная** ячейка | `код в ячейке` |
    || пустая | |
    |
    |```bsl
    |// Автозамены не должны сработать: -- (c) ""text""
    |Процедура Привет()
    |    Сообщить(""Привет, мир!"");
    |КонецПроцедуры
    |```";
    
КонецФункции

&НаКлиенте
