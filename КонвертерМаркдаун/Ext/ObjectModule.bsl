////////////////////////////////////////////////////////////////////////////////
// Модуль объекта обработки "КонвертерMarkdownВWord".
// Версия: 1.0.0.
//
// Роль модуля: серверное заполнение формы значениями по умолчанию.
// Конвейер конвертации (COM Word) исполняется в модуле формы
// в клиентском контексте: Word открывается на компьютере пользователя,
// файловые пути - локальные.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс
// Формирует настройки конвертации по умолчанию.
//
// Возвращаемое значение:
//   Структура - настройки конвертации.
//
Функция НастройкиПоУмолчанию() Экспорт
    
    Настройки = Новый Структура;
    
    // ======================================================================
    // 1. ЗАМЕНЫ ПЕРЕД РАЗБОРОМ - основное место настройки замен.
    //    Применяются к исходному тексту ДО разбора Markdown.
    //    Внимание: действуют на весь текст, включая блоки кода.
    // ======================================================================
    Замены = Новый Массив;
	Замены.Добавить(НоваяЗамена("«", """"));
	Замены.Добавить(НоваяЗамена("»", """"));
	Замены.Добавить(НоваяЗамена("—", "-"));
	Замены.Добавить(НоваяЗамена("(c)", "©"));
	Замены.Добавить(НоваяЗамена("(r)", "®"));
	Замены.Добавить(НоваяЗамена("(tm)", "™"));
    // Пример регулярной замены: альтернативная запись жирного "__текст__"
    // приводится к канонической "**текст**".
    Замены.Добавить(НоваяЗамена("__(\S(?:.*?\S)?)__", "**$1**", Истина));    
	
    Настройки.Вставить("ЗаменыПередРазбором", Замены);
    
    // ======================================================================
    // 2. СТИЛИ ЗАГОЛОВКОВ: "уровень Markdown -> стиль Word".
    //    Вариативность: значением может быть число (код встроенного стиля,
    //    не зависит от языка Word: wdStyleHeading1 = -2 ... Heading6 = -7)
    //    или строка - имя стиля, например "Заголовок 1" или имя стиля
    //    из шаблона документа.
    // ======================================================================
    СтилиЗаголовков = Новый Соответствие;
    СтилиЗаголовков.Вставить(1, -2);
    СтилиЗаголовков.Вставить(2, -3);
    СтилиЗаголовков.Вставить(3, -4);
    СтилиЗаголовков.Вставить(4, -5);
    СтилиЗаголовков.Вставить(5, -6);
    СтилиЗаголовков.Вставить(6, -7);
    Настройки.Вставить("СтилиЗаголовков", СтилиЗаголовков);
    
    // ======================================================================
    // 3. ШАБЛОН ДОКУМЕНТА (фирменный бланк со своими стилями).
    // ======================================================================
    Настройки.Вставить("ПутьКШаблону", "");
    
    // ======================================================================
    // 4. ШРИФТЫ И ОФОРМЛЕНИЕ.
    // ======================================================================
    Настройки.Вставить("ШрифтТекста", Новый Структура("Имя, Размер", "Calibri", 11));
    
    Настройки.Вставить("ПараметрыСтрочногоКода",
        Новый Структура("ИмяШрифта, Размер", "Consolas", 10));
    
    Настройки.Вставить("ПараметрыБлокаКода",
        Новый Структура("ИмяШрифта, Размер, Отступ, ЗаливатьФон, ЦветФона",
            "Consolas", 10, 14, Истина, ЦветWord(242, 242, 242)));
    
    Настройки.Вставить("ПараметрыЦитаты",
        Новый Структура("Отступ, Курсив, ЛеваяЛиния, ЦветФона",
            18, Истина, Истина, ЦветWord(242, 242, 242)));
    
    Настройки.Вставить("ПараметрыТаблицы",
        Новый Структура("ЦветШапки", ЦветWord(217, 217, 217)));
    
    // ======================================================================
    // 5. СПИСКИ. Вариативность: настоящие списки Word (маркеры/нумерация)
    //    или текстовые маркеры (режим без ListFormat, надежнее).
    // ======================================================================
    Настройки.Вставить("ИспользоватьСпискиWord", Истина);
    Настройки.Вставить("ШагОтступаСписка", 18);				// пункты на уровень вложенности
    Настройки.Вставить("ПробеловНаУровеньВложенности", 2);	// отступ в исходном Markdown на уровень     
	Настройки.Вставить("ВыступМаркера", 18);	// пункты: маркер левее текста списка
    	
	// ======================================================================
	// 7. МАТЕМАТИКА. LaTeX-команды -> Unicode-символы. ВАЖНО: порядок -
	// более длинные шаблоны раньше коротких (\leftarrow раньше \le,
	// \infty раньше \in), это простые СтрЗаменить по очереди.
	// Дополняется вызывающим кодом (или формой - по образцу ТаблицаЗамен).
	// ======================================================================
	СимволыМатематика = Новый Массив;
	СимволыМатематика.Добавить(НоваяЗамена("\rightarrow",	"→"));
	СимволыМатематика.Добавить(НоваяЗамена("\leftarrow",	"←"));
	СимволыМатематика.Добавить(НоваяЗамена("\varepsilon",	"ε"));
	СимволыМатематика.Добавить(НоваяЗамена("\epsilon",	"ε"));
	СимволыМатематика.Добавить(НоваяЗамена("\infty",	"∞"));
	СимволыМатематика.Добавить(НоваяЗамена("\neq",		"≠"));
	СимволыМатематика.Добавить(НоваяЗамена("\geq",		"≥"));
	СимволыМатематика.Добавить(НоваяЗамена("\leq",		"≤"));
	СимволыМатематика.Добавить(НоваяЗамена("\int",		"∫"));
	СимволыМатематика.Добавить(НоваяЗамена("\ne",		"≠"));
	СимволыМатематика.Добавить(НоваяЗамена("\ge",		"≥"));
	СимволыМатематика.Добавить(НоваяЗамена("\le",		"≤"));
	СимволыМатематика.Добавить(НоваяЗамена("\in",		"∈"));
	СимволыМатематика.Добавить(НоваяЗамена("\to",		"→"));
	СимволыМатематика.Добавить(НоваяЗамена("\alpha",	"α"));
	СимволыМатематика.Добавить(НоваяЗамена("\beta",	"β"));
	СимволыМатематика.Добавить(НоваяЗамена("\gamma",	"γ"));
	СимволыМатематика.Добавить(НоваяЗамена("\delta",	"δ"));
	СимволыМатематика.Добавить(НоваяЗамена("\Delta",	"Δ"));
	СимволыМатематика.Добавить(НоваяЗамена("\theta",	"θ"));
	СимволыМатематика.Добавить(НоваяЗамена("\lambda",	"λ"));
	СимволыМатематика.Добавить(НоваяЗамена("\mu",		"μ"));
	СимволыМатематика.Добавить(НоваяЗамена("\nu",		"ν"));
	СимволыМатематика.Добавить(НоваяЗамена("\pi",		"π"));
	СимволыМатематика.Добавить(НоваяЗамена("\rho",		"ρ"));
	СимволыМатематика.Добавить(НоваяЗамена("\sigma",	"σ"));
	СимволыМатематика.Добавить(НоваяЗамена("\Sigma",	"Σ"));
	СимволыМатематика.Добавить(НоваяЗамена("\tau",		"τ"));
	СимволыМатематика.Добавить(НоваяЗамена("\phi",		"φ"));
	СимволыМатематика.Добавить(НоваяЗамена("\psi",		"ψ"));
	СимволыМатематика.Добавить(НоваяЗамена("\omega",	"ω"));
	СимволыМатематика.Добавить(НоваяЗамена("\ell",		"ℓ"));
	СимволыМатематика.Добавить(НоваяЗамена("\approx",	"≈"));
	СимволыМатематика.Добавить(НоваяЗамена("\times",	"×"));
	СимволыМатематика.Добавить(НоваяЗамена("\cdot",	"·"));
	СимволыМатематика.Добавить(НоваяЗамена("\pm",		"±"));
	СимволыМатематика.Добавить(НоваяЗамена("\partial",	"∂"));
	СимволыМатематика.Добавить(НоваяЗамена("\nabla",	"∇"));
	СимволыМатематика.Добавить(НоваяЗамена("\max",		"max"));
	СимволыМатематика.Добавить(НоваяЗамена("\min",		"min"));
	СимволыМатематика.Добавить(НоваяЗамена("\exp",		"exp"));
	СимволыМатематика.Добавить(НоваяЗамена("\log",		"log"));
	СимволыМатематика.Добавить(НоваяЗамена("\|",		"‖"));
	СимволыМатематика.Добавить(НоваяЗамена("\{",		"{"));
	СимволыМатематика.Добавить(НоваяЗамена("\}",		"}"));
	СимволыМатематика.Добавить(НоваяЗамена("\%",		"%"));
	СимволыМатематика.Добавить(НоваяЗамена("-",		"−"));	// типографский минус, последняя - коротчайшая
	Настройки.Вставить("МатематическиеСимволы", СимволыМатематика); 
	
	// ======================================================================
    // 6. ПРОЧЕЕ.
    // ======================================================================
    Настройки.Вставить("БазовыйКаталог", "");			// каталог MD-файла: резолвинг относительных путей картинок
    Настройки.Вставить("ИнтервалПослеАбзаца", 6);		// пункты
    Настройки.Вставить("МаксимальнаяШиринаКартинки", 450);	// пункты, 0 - не масштабировать
    Настройки.Вставить("ПоказатьДокумент", Истина);

	
    Возврат Настройки;
    
КонецФункции

// Формирует описание одной замены для раздела "ЗаменыПередРазбором".
//
// Параметры:
//   Шаблон           - Строка - искомая строка или шаблон регулярного выражения;
//   Значение         - Строка - строка замены (для регулярных допустимы $1, $2...);
//   ЭтоРегулярное    - Булево - интерпретировать Шаблон как регулярное выражение;
//   УчитыватьРегистр - Булево - учитывать регистр символов.
//
Функция НоваяЗамена(Знач Шаблон, Знач Значение, Знач ЭтоРегулярное = Ложь, Знач УчитыватьРегистр = Ложь) Экспорт
    
    Возврат Новый Структура("Шаблон, Значение, ЭтоРегулярное, УчитыватьРегистр",
        Шаблон, Значение, ЭтоРегулярное, УчитыватьРегистр);
    
КонецФункции

// Обратное преобразование: настройки -> таблицы и скалярные поля для
// заполнения формы. Вызывать в СЕРВЕРНОМ контексте
// (реквизиты формы заполняются через РеквизитТЗ.Загрузить).
//
// Возвращаемое значение:
//   Структура - ТаблицаЗамен (ТЗ), ТаблицаСтилейЗаголовков (ТЗ), Поля (Структура).
//
Функция ДанныеФормыИзНастроек(Знач Настройки = Неопределено) Экспорт
    
    Если Настройки = Неопределено Тогда
        Настройки = НастройкиПоУмолчанию();
    КонецЕсли;
    
    ТаблицаЗамен = Новый ТаблицаЗначений;
    ТаблицаЗамен.Колонки.Добавить("Шаблон", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(200)));
    ТаблицаЗамен.Колонки.Добавить("Значение", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(200)));
    ТаблицаЗамен.Колонки.Добавить("ЭтоРегулярное", Новый ОписаниеТипов("Булево"));
    ТаблицаЗамен.Колонки.Добавить("УчитыватьРегистр", Новый ОписаниеТипов("Булево"));
    
    Для Каждого Замена Из Настройки.ЗаменыПередРазбором Цикл
        СтрокаТаблицы = ТаблицаЗамен.Добавить();
        СтрокаТаблицы.Шаблон = Замена.Шаблон;
        СтрокаТаблицы.Значение = Замена.Значение;
        СтрокаТаблицы.ЭтоРегулярное = Замена.ЭтоРегулярное;
        СтрокаТаблицы.УчитыватьРегистр = Замена.УчитыватьРегистр;
    КонецЦикла;
    
    ТаблицаСтилей = Новый ТаблицаЗначений;
    ТаблицаСтилей.Колонки.Добавить("Уровень", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(2, 0)));
    ТаблицаСтилей.Колонки.Добавить("Стиль", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(100)));
    
    Для Уровень = 1 По 6 Цикл
        Стиль = Настройки.СтилиЗаголовков.Получить(Уровень);
        СтрокаТаблицы = ТаблицаСтилей.Добавить();
        СтрокаТаблицы.Уровень = Уровень;
        СтрокаТаблицы.Стиль = ?(Стиль = Неопределено, "", Строка(Стиль));
    КонецЦикла;
    
    Поля = Новый Структура;
    Поля.Вставить("ШрифтТекстаИмя", Настройки.ШрифтТекста.Имя);
    Поля.Вставить("ШрифтТекстаРазмер", Настройки.ШрифтТекста.Размер);
    Поля.Вставить("ШрифтКодаИмя", Настройки.ПараметрыСтрочногоКода.ИмяШрифта);
    Поля.Вставить("ШрифтКодаРазмер", Настройки.ПараметрыСтрочногоКода.Размер);
    Поля.Вставить("ОтступБлокаКода", Настройки.ПараметрыБлокаКода.Отступ);
    Поля.Вставить("ЗаливатьФонКода", Настройки.ПараметрыБлокаКода.ЗаливатьФон);
    Поля.Вставить("ЦветФонаКода", СтрокаЦвета(Настройки.ПараметрыБлокаКода.ЦветФона));
    Поля.Вставить("ОтступЦитаты", Настройки.ПараметрыЦитаты.Отступ);
    Поля.Вставить("ЦитатыКурсивом", Настройки.ПараметрыЦитаты.Курсив);
    Поля.Вставить("ЦитатыЛеваяЛиния", Настройки.ПараметрыЦитаты.ЛеваяЛиния);
    Поля.Вставить("ЦветФонаЦитаты", СтрокаЦвета(Настройки.ПараметрыЦитаты.ЦветФона));
    Поля.Вставить("ЦветШапкиТаблицы", СтрокаЦвета(Настройки.ПараметрыТаблицы.ЦветШапки));
    Поля.Вставить("ИспользоватьСпискиWord", Настройки.ИспользоватьСпискиWord);
    Поля.Вставить("ШагОтступаСписка", Настройки.ШагОтступаСписка);
    Поля.Вставить("ПробеловНаУровень", Настройки.ПробеловНаУровеньВложенности);
    Поля.Вставить("ИнтервалПослеАбзаца", Настройки.ИнтервалПослеАбзаца);
    Поля.Вставить("МаксимальнаяШиринаКартинки", Настройки.МаксимальнаяШиринаКартинки);
    Поля.Вставить("ПоказатьДокумент", Настройки.ПоказатьДокумент);
    Поля.Вставить("БазовыйКаталог", Настройки.БазовыйКаталог);
    Поля.Вставить("ПутьКШаблону", Настройки.ПутьКШаблону);
    
    Возврат Новый Структура("ТаблицаЗамен, ТаблицаСтилейЗаголовков, Поля",
        ТаблицаЗамен, ТаблицаСтилей, Поля);
    
КонецФункции
#КонецОбласти
  
#Область СлужебныеПроцедурыИФункции

// Преобразует компоненты цвета RGB в числовое значение цвета
// объектной модели Word (байты в порядке BGR).
Функция ЦветWord(Знач Красный, Знач Зеленый, Знач Синий)
    
    Возврат Синий * 65536 + Зеленый * 256 + Красный;
    
КонецФункции

// Значение цвета Word -> "242, 242, 242". 0 или меньше -> "" (без заливки).
Функция СтрокаЦвета(Знач ЗначениеЦвета)
    
    Если ЗначениеЦвета <= 0 Тогда
        Возврат "";
    КонецЕсли;
    
    Красный = ЗначениеЦвета % 256;
    Зеленый = Цел(ЗначениеЦвета / 256) % 256;
    Синий = Цел(ЗначениеЦвета / 65536);
    
    Возврат Формат(Красный, "ЧГ=0") + ", " + Формат(Зеленый, "ЧГ=0") + ", " + Формат(Синий, "ЧГ=0");
    
КонецФункции

#КонецОбласти

#Область РегистрацияВИнформационнойБазе

Функция СведенияОВнешнейОбработке() Экспорт
    
	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Наименование", НСтр("ru = 'Конвертер Markdown в Word'"));
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);
	ПараметрыРегистрации.Вставить("Версия", "1.0.0");
	ПараметрыРегистрации.Вставить("Информация", НСтр("ru = 'Конвертер Markdown в Word...'"));
	ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка");
	
	ТаблицаКоманд = Новый ТаблицаЗначений;
	ТаблицаКоманд.Колонки.Добавить("Идентификатор");
	ТаблицаКоманд.Колонки.Добавить("Использование");
	ТаблицаКоманд.Колонки.Добавить("Представление");
	
	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Идентификатор = "КонвертерМаркдаун";
	НоваяКоманда.Использование = "ОткрытиеФормы";
	НоваяКоманда.Представление = НСтр("ru = 'Конвертер Markdown в Word'");
	
	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);
	
	Возврат ПараметрыРегистрации;
    
КонецФункции
#КонецОбласти